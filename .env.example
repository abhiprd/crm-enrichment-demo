# Copy to .env (already created, git-ignored). Never commit .env.
# Do NOT set ANTHROPIC_API_KEY: Claude Code would bill the API instead of your subscription.

# OpenAI, all calls go through crm/llm.py. Luna extracts; Sol only writes rules (M4).
OPENAI_API_KEY=
OPENAI_EXTRACTOR_MODEL=gpt-6-luna
OPENAI_EXTRACTOR_EFFORT=       # none | low | medium; set from results/bakeoff.json
OPENAI_LEARNER_MODEL=gpt-6.1-sol
EXTRACTOR_PRICE_IN_PER_MTOK=   # USD per 1M input tokens, from the provider's price page
EXTRACTOR_PRICE_OUT_PER_MTOK=  # output price; reasoning tokens bill as output
LEARNER_PRICE_IN_PER_MTOK=
LEARNER_PRICE_OUT_PER_MTOK=

# HubSpot service key (scopes: deals + companies read/write, deal schemas read/write, owners read)
HUBSPOT_SERVICE_KEY=
HUBSPOT_OWNER_ID=              # optional; default is the first owner returned by /crm/v3/owners

# Slack (Socket Mode). Bot scopes: chat:write, users:read, users:read.email
SLACK_BOT_TOKEN=               # xoxb-...
SLACK_APP_TOKEN=               # xapp-... (connections:write)
SLACK_REVIEW_CHANNEL=          # channel ID (or user ID) for review cards
SLACK_ESCALATION_CHANNEL=      # stretch: manager escalation channel ID
SLACK_DIGEST_CHANNEL=          # stretch: weekly digest channel ID
SLACK_REVIEWER_IDS=            # fallback reviewers when the record owner cannot be mapped to a Slack user
SLACK_MANAGER_IDS=             # comma-separated Slack user IDs allowed to review any card
